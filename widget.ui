    color: #2c3e50;
}
QLineEdit {
    border: 1px solid #dcdfe6;
    border-radius: 4px;
    padding: 4px 8px;
    background-color: #ffffff;
    color: #2c3e50;
}
QLineEdit:focus { border-color: #409eff; }
QComboBox {
    border: 1px solid #dcdfe6;
    border-radius: 4px;
    min-height: 24px;
    background-color: #ffffff;
    color: #2c3e50;
}
QComboBox::drop-down {
    subcontrol-origin: padding;
    subcontrol-position: top right;
    width: 20px;
    border-left: 1px solid #dcdfe6;
}
